# Placeholder-only example. Copy to .env and fill in locally; never commit .env.
# The app reads only the two API keys from .env, at runtime, and never displays or logs them.
# Both are optional: without them only the offline demo mode is offered.

# Live AI drafting (OpenAI). Capped in code at $0.10 per briefing and $1 per day.
OPENAI_API_KEY=
# Live news (Tavily); used only together with the OpenAI key. Capped at 5 credits per briefing, 50 per day.
TAVILY_API_KEY=

# Other settings (CHROMA_DIR, EMBEDDING_MODEL, DEAL_PREP_HISTORY_DB, DEAL_PREP_FONT_DIR, HF_HUB_OFFLINE, ...)
# are read from the process environment, not from this file. See README.md, "Configuration".
